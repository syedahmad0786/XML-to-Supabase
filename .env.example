# ─── LLM Providers ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ─── Vector Store (Pinecone) ─────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX=sales-agent-memory
PINECONE_ENVIRONMENT=us-east-1

# ─── Supabase (Lead DB + Auth) ───────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=

# ─── Lead Sourcing ───────────────────────────────────────────────
APOLLO_API_KEY=
CLAY_API_KEY=
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
LINKEDIN_SALES_NAV_COOKIE=

# ─── LinkedIn Automation ────────────────────────────────────────
# Webhook URL for your LinkedIn automation tool (Phantombuster, Expandi, Dripify)
# If not set, LinkedIn steps will be logged but not executed (dry run mode)
LINKEDIN_AUTOMATION_ENDPOINT=

# ─── Email (optional — if not configured, email steps run in dry-run mode)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=
EMAIL_FROM_ADDRESS=

# ─── Instagram ───────────────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ─── Booking ─────────────────────────────────────────────────────
CALENDLY_API_KEY=
CALENDLY_EVENT_TYPE_URI=
GOOGLE_CALENDAR_CREDENTIALS_PATH=./credentials/google-calendar.json

# ─── HITL (Human-in-the-Loop) ────────────────────────────────────
SLACK_WEBHOOK_URL=
SLACK_APPROVAL_CHANNEL=#sales-approvals
DISCORD_WEBHOOK_URL=

# ─── Redis (Queue + Cache) ───────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Agent Config ────────────────────────────────────────────────
LEAD_SCORE_THRESHOLD=8
MAX_LEADS_PER_DAY=50
OUTREACH_DELAY_MINUTES=60
DEEP_RESEARCH_ENABLED=true
HITL_REQUIRED_FOR_FIRST_MESSAGE=true
